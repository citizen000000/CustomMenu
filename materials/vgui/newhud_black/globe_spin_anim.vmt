"UnlitGeneric"
{
    "$basetexture" "vgui/newhud_black/globe_spin_anim"
    "$translucent" "1"
    "$vertexcolor" "1"
    "$vertexalpha" "1"
    "$ignorez" "1"
    "$frame" "0"
    "Proxies" { "AnimatedTexture" { "animatedTextureVar" "$basetexture" "animatedTextureFrameNumVar" "$frame" "animatedTextureFrameRate" "8" } }
}